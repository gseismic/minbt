-            if not cursor.ordered:
-                source_entries.sort(key=lambda item: (datetime_key(item[2].dt), item[1]))
-            entries.extend(source_entries)
-        entries.sort(key=lambda item: (datetime_key(item[2].dt), item[0].registration_index, item[1]))
